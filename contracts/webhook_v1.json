{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DriftAlert v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "created_at", "model_name", "severity", "window"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["v1"] },
    "event_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "model_name": { "type": "string" },
    "model_version": { "type": ["string", "null"] },
    "model_alias": { "type": ["string", "null"] },
    "model_uri": { "type": ["string", "null"] },
    "previous_severity": { "type": ["string", "null"], "enum": ["stable", "moderate", "critical", null] },
    "severity": { "type": "string", "enum": ["stable", "moderate", "critical"] },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": { "type": "integer" },
        "start": { "type": ["string", "null"], "format": "date-time" },
        "end": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "numeric_drift": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "psi", "severity"],
        "properties": {
          "feature": { "type": "string" },
          "psi": { "type": "number" },
          "severity": { "type": "string", "enum": ["stable", "moderate", "critical"] }
        }
      }
    },
    "categorical_drift": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "p_value", "severity"],
        "properties": {
          "feature": { "type": "string" },
          "p_value": { "type": "number" },
          "severity": { "type": "string", "enum": ["stable", "moderate", "critical"] }
        }
      }
    },
    "output_drift": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "psi": { "type": ["number", "null"] },
        "positive_rate_reference": { "type": ["number", "null"] },
        "positive_rate_current": { "type": ["number", "null"] },
        "severity": { "type": "string", "enum": ["stable", "moderate", "critical"] }
      }
    },
    "idempotency_key": { "type": ["string", "null"] }
  }
}
