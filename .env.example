MLFLOW_TRACKING_URI=http://mlflow:5000     # MLflow tracking server
POSTGRES_DSN=postgresql+asyncpg://user:pass@postgres:5432/drift    # Agent checkpoints + HIL store
REDIS_URL=redis://redis:6379/0              # Job queue for worker
PLATFORM_BASE_URL=http://platform:8000       # Platform service
AGENT_BASE_URL=http://agent:8001             # Agent service
LLM_PROVIDER=openai                          # openai or anthropic
LLM_MODEL=gpt-4o                             # LLM model name
LLM_API_KEY=                                 # API key for LLM provider
