MLFLOW_TRACKING_URI=http://mlflow:5000     # Docker service name; use http://localhost:5000 for local dev
POSTGRES_DSN=postgresql+asyncpg://user:pass@postgres:5432/drift    # Agent checkpoints + HIL store
REDIS_URL=redis://redis:6379/0              # Job queue for worker
PLATFORM_BASE_URL=http://platform:8000       # Platform service
AGENT_BASE_URL=http://agent:8001             # Agent service
LLM_PROVIDER=mock                            # mock or azure
LLM_MODEL=gpt-4o                             # LLM model name
LLM_API_KEY=                                 # API key for LLM provider
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_STRONG_MODEL=Kimi-K2.6-1
AZURE_OPENAI_DEPLOYMENT=Kimi-K2.6-1
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=drift-triage-copilot
LANGGRAPH_API_KEY=
