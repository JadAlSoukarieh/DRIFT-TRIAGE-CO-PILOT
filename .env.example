POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=drift
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql+asyncpg://user:pass@postgres:5432/drift
REDIS_URL=redis://redis:6379/0
MLFLOW_TRACKING_URI=http://mlflow:5000
PLATFORM_BASE_URL=http://platform:8000
AGENT_BASE_URL=http://agent:8001

# Local manual overrides
LOCAL_PLATFORM_BASE_URL=http://127.0.0.1:8000
LOCAL_AGENT_BASE_URL=http://127.0.0.1:8001
LOCAL_POSTGRES_DSN=postgresql+asyncpg://user:pass@127.0.0.1:55432/drift

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Dashboard-in-Docker URLs
DASHBOARD_PLATFORM_BASE_URL=http://platform:8000
DASHBOARD_AGENT_BASE_URL=http://agent:8001

# LLM
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_STRONG_MODEL=Kimi-K2.6-1
AZURE_OPENAI_DEPLOYMENT=Kimi-K2.6-1

# LangSmith / LangChain tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=drift-triage-copilot
